	partition Matches = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "Matches.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"match_key", Int64.Type}, {"source_match_id", Int64.Type}, {"match_date", type date}, {"season_key", Int64.Type}, {"venue_key", Int64.Type}, {"bat_first_franchise", type text}, {"bat_first_team", type text}, {"chase_franchise", type text}, {"chase_team", type text}, {"toss_winner_franchise", type text}, {"toss_decision", type text}, {"toss_winner_bat_first", Int64.Type}, {"winner_franchise", type text}, {"winner_team", type text}, {"match_status", type text}, {"result_type", type text}, {"result_margin", type number}, {"is_super_over", Int64.Type}, {"is_dl_applied", Int64.Type}, {"inn1_pp_runs", Int64.Type}, {"inn1_pp_wickets", Int64.Type}, {"inn1_pp_run_rate", type number}, {"inn1_pp_dot_pct", type number}, {"inn1_total_runs", Int64.Type}, {"inn1_wickets", Int64.Type}, {"inn2_pp_runs", type number}, {"inn2_pp_wickets", type number}, {"inn2_pp_run_rate", type number}, {"inn2_pp_dot_pct", type number}, {"inn2_total_runs", type number}, {"inn2_wickets", type number}, {"pp_run_rate_diff", type number}, {"bat_first_won", type number}, {"ml_eligible", Int64.Type}, {"toss_winner_won", type number}, {"player_of_match", type text}, {"pp_diff_band", type text}, {"pp_diff_band_order", type number}, {"chase_pp_wickets_band", type text}, {"chase_pp_wickets_order", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

