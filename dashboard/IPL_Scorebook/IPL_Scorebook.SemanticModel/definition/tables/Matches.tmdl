table Matches
	lineageTag: 67d27681-604a-553e-81a0-807705c22e47

	measure 'Match Count' = COUNTROWS ( Matches )
		formatString: #,0
		displayFolder: Matches
		lineageTag: 5b474ced-75eb-525d-9b7c-9d800cfc6350

	measure 'Avg First-Innings Score' = CALCULATE ( AVERAGE ( Matches[inn1_total_runs] ), Matches[match_status] = "completed" )
		formatString: 0
		displayFolder: Matches
		lineageTag: 54ebbde9-0985-5bbf-8ea7-81dad694090b

	measure 'Avg 1st Inns (10+ matches)' = IF ( [Match Count] >= 10, [Avg First-Innings Score] )
		formatString: 0
		displayFolder: Matches
		lineageTag: 15473d39-c588-5c14-9b75-b5359dfd176b

	measure '200+ Totals' = CALCULATE ( COUNTROWS ( Matches ), Matches[inn1_total_runs] >= 200 ) + CALCULATE ( COUNTROWS ( Matches ), Matches[inn2_total_runs] >= 200 ) + 0
		formatString: #,0
		displayFolder: Matches
		lineageTag: 93535ebc-90fb-5305-a658-f5146c90d7e1

	measure '200+ Totals Last Season' = VAR s = MAX ( Season[season] ) RETURN CALCULATE ( [200+ Totals], Season[season] = s )
		formatString: #,0
		displayFolder: Matches
		lineageTag: fbeaa6f5-7182-5bca-86b8-1ce9256f1aef

	measure 'Toss Winner Win %' = AVERAGE ( Matches[toss_winner_won] )
		formatString: 0.0%
		displayFolder: Matches
		lineageTag: 6eeea44c-ea86-5f67-b2ec-5aaa93fb9d3c

	measure 'Chose To Field %' = DIVIDE ( CALCULATE ( COUNTROWS ( Matches ), Matches[toss_decision] = "field" ), COUNTROWS ( Matches ) )
		formatString: 0%
		displayFolder: Matches
		lineageTag: 800578d3-24bd-5c8e-a2dd-4386c1f54c1a

	measure 'Bat-First Win %' = CALCULATE ( AVERAGE ( Matches[bat_first_won] ), Matches[ml_eligible] = 1 )
		formatString: 0%
		displayFolder: Matches
		lineageTag: a723b294-2b6e-5655-9cf0-7bc82e78955e

	measure 'Chase Win %' = CALCULATE ( 1 - AVERAGE ( Matches[bat_first_won] ), Matches[ml_eligible] = 1 )
		formatString: 0%
		displayFolder: Matches
		lineageTag: 98d9bbea-aef2-5307-8c82-4b510026afd2

	measure 'Higher PP Rate Wins %' = CALCULATE ( AVERAGEX ( Matches, IF ( ( Matches[pp_run_rate_diff] > 0 ) = ( Matches[bat_first_won] = 1 ), 1, 0 ) ), Matches[ml_eligible] = 1, Matches[pp_run_rate_diff] <> 0 )
		formatString: 0.0%
		displayFolder: Matches
		lineageTag: 90bc907b-6131-5277-aecf-f52756792b76

