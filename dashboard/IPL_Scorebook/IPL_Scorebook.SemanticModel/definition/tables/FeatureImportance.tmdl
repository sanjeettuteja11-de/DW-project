table FeatureImportance
	lineageTag: 151e618d-aae6-5f08-960f-5ee1f86bb4fe

	measure 'RF Importance' = CALCULATE ( SUM ( FeatureImportance[abs_value] ), MLModel[model] = "random_forest" )
		formatString: 0.000
		displayFolder: Model
		lineageTag: 47af05ab-23f8-5db3-b853-8938e6c35e02

	column feature_set
