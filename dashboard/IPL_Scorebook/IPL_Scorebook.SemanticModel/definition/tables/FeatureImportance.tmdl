		summarizeBy: none
		sourceColumn: feature_label

		annotation SummarizationSetBy = Automatic

	partition FeatureImportance = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "FeatureImportance.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"feature_set", type text}, {"model", type text}, {"feature", type text}, {"value", type number}, {"model_label", type text}, {"abs_value", type number}, {"feature_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

