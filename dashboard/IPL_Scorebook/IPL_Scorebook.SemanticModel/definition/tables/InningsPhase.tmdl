	partition InningsPhase = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "InningsPhase.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"match_key", Int64.Type}, {"season_key", Int64.Type}, {"venue_key", Int64.Type}, {"inning", Int64.Type}, {"phase_key", Int64.Type}, {"batting_franchise", type text}, {"bowling_franchise", type text}, {"runs", Int64.Type}, {"legal_balls", Int64.Type}, {"wickets", Int64.Type}, {"boundaries", Int64.Type}, {"dots", Int64.Type}, {"balls_faced", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

