table InningsPhase
	lineageTag: 6dfeb646-c4bc-597f-85bd-201f696d3804

	measure 'Total Runs' = SUM ( InningsPhase[runs] )
		formatString: #,0
		displayFolder: Scoring
		lineageTag: 981a667e-96d9-5506-93f8-cda59f23af35

	measure 'Legal Balls' = SUM ( InningsPhase[legal_balls] )
		formatString: #,0
		displayFolder: Scoring
		lineageTag: 972c28ae-94cc-59ba-809e-7357bc89bc4f

	measure 'Run Rate' = DIVIDE ( [Total Runs] * 6, [Legal Balls] )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: d1f49254-e8cf-5957-a32f-0e3fd917614e

	measure 'Boundary %' = DIVIDE ( SUM ( InningsPhase[boundaries] ), SUM ( InningsPhase[balls_faced] ) )
		formatString: 0.0%
		displayFolder: Scoring
		lineageTag: 80978350-647c-56d6-b74f-ec22b359ba44

	measure 'Dot %' = DIVIDE ( SUM ( InningsPhase[dots] ), [Legal Balls] )
		formatString: 0.0%
		displayFolder: Scoring
		lineageTag: b9c2e317-27a3-5c97-9687-4788b9200271

	measure 'PP Run Rate' = CALCULATE ( [Run Rate], Phase[phase] = "Powerplay" )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: d05d0e9b-d124-5cdc-a2c4-bc3775b939d1

	measure 'PP Boundary %' = CALCULATE ( [Boundary %], Phase[phase] = "Powerplay" )
		formatString: 0.0%
		displayFolder: Scoring
		lineageTag: 9ff964fe-41b3-53af-a055-5280f945a699

	measure 'PP Dot %' = CALCULATE ( [Dot %], Phase[phase] = "Powerplay" )
		formatString: 0.0%
		displayFolder: Scoring
		lineageTag: 5cb666a6-cec6-5e83-bdcb-84da7066385e

	measure 'PP RR First Season' = VAR s = MIN ( Season[season] ) RETURN CALCULATE ( [PP Run Rate], Season[season] = s )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: 5d6ab14e-4d59-5491-9072-11b664505db3

	measure 'PP RR Last Season' = VAR s = MAX ( Season[season] ) RETURN CALCULATE ( [PP Run Rate], Season[season] = s )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: 95372c1f-1e5a-5594-b329-ce252c9788b0

	measure 'PP RR Change' = DIVIDE ( [PP RR Last Season], [PP RR First Season] ) - 1
		formatString: +0%;-0%;0%
		displayFolder: Scoring
		lineageTag: 4fa04596-2e4f-57ac-8ad4-2c68a374051c

