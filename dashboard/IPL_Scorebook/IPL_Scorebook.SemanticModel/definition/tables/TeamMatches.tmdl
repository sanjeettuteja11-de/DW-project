table TeamMatches
	lineageTag: cb988d6e-896b-550c-88db-72235382d435

	measure 'Team Win %' = AVERAGE ( TeamMatches[won] )
		formatString: 0.0%
		displayFolder: Teams
		lineageTag: 0258ab7e-bc4f-5b0d-b4ad-f03830abc16e

	measure 'Team Matches' = COUNTROWS ( TeamMatches )
		formatString: #,0
		displayFolder: Teams
		lineageTag: 47c56129-917b-5c3c-82f0-72140f0fcba2

	column match_key
		dataType: int64
		formatString: 0
		lineageTag: 7f1a9dd3-f457-5fc4-aa2a-7ecf1a8d8589
		summarizeBy: none
		isHidden
		sourceColumn: match_key

		annotation SummarizationSetBy = Automatic

	column season_key
