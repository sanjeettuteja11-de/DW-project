		sourceColumn: total_runs

		annotation SummarizationSetBy = Automatic

	partition TeamMatches = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "TeamMatches.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"match_key", Int64.Type}, {"season_key", Int64.Type}, {"venue_key", Int64.Type}, {"franchise_id", type text}, {"team_name", type text}, {"role", type text}, {"won", type number}, {"pp_run_rate", type number}, {"total_runs", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

