	partition PlayerSeasonPhase = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "PlayerSeasonPhase.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"player_key", Int64.Type}, {"player", type text}, {"season_key", Int64.Type}, {"role_type", type text}, {"phase_key", Int64.Type}, {"balls", Int64.Type}, {"runs", Int64.Type}, {"wickets", Int64.Type}, {"boundaries", Int64.Type}, {"dots", Int64.Type}, {"strike_rate", type number}, {"economy", type number}, {"season_balls", Int64.Type}, {"phase_share", type number}, {"league_phase_share", type number}, {"phase_index", type number}, {"qualifies", Int64.Type}, {"is_primary_phase", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

