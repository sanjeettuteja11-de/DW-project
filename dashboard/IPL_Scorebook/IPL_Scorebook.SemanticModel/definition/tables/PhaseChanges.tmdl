	partition PhaseChanges = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "PhaseChanges.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"player", type text}, {"player_key", Int64.Type}, {"role_type", type text}, {"from_phase", type text}, {"to_phase", type text}, {"from_season", Int64.Type}, {"to_season", Int64.Type}, {"seasons_between", Int64.Type}, {"from_phase_index_before", type number}, {"to_phase_index_before", type number}, {"from_phase_index_after", type number}, {"to_phase_index_after", type number}, {"index_shift", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

