table PhaseChanges
	lineageTag: e5d114c6-f433-55b4-a940-507886d4d838

	measure 'Phase Changes' = COUNTROWS ( PhaseChanges )
		formatString: #,0
		displayFolder: Phase drift
		lineageTag: 2662512e-a83e-5f66-98a5-24dbb6262f47

	measure 'Moves Touching Middle %' = DIVIDE ( CALCULATE ( COUNTROWS ( PhaseChanges ), FILTER ( PhaseChanges, PhaseChanges[from_phase] = "Middle" || PhaseChanges[to_phase] = "Middle" ) ), COUNTROWS ( PhaseChanges ) )
		formatString: 0%
		displayFolder: Phase drift
		lineageTag: 8a15681a-d211-52cc-b70c-9f4b74998c04

