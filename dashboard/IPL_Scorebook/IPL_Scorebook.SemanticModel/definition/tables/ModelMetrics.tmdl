table ModelMetrics
	lineageTag: 53dbfc66-a999-56a4-9bce-646945e5e547

	measure 'Test Accuracy' = AVERAGE ( ModelMetrics[accuracy] )
		formatString: 0.0%
		displayFolder: Model
		lineageTag: 9746dd06-91c5-5779-adb0-1c9ea9e50148

	measure 'ROC AUC' = AVERAGE ( ModelMetrics[roc_auc] )
		formatString: 0.00
		displayFolder: Model
		lineageTag: 0224f1fe-ad72-56b8-8bed-d4441750c266

	measure 'Baseline Accuracy' = CALCULATE ( [Test Accuracy], REMOVEFILTERS ( MLModel ), MLModel[is_baseline] = 1, MLModel[model] <> "baseline_majority" )
		formatString: 0.0%
		displayFolder: Model
		lineageTag: c0a7179b-832c-5bb9-8d97-ce5262edca66

	measure 'Selected Model' = CALCULATE ( SELECTEDVALUE ( TestPredictions[model] ), REMOVEFILTERS ( MLModel ) )
		displayFolder: Model
		lineageTag: 60aa1dd1-ca9a-582e-86a6-6972a5160669

	measure 'Model Bar Colour' = IF ( SELECTEDVALUE ( MLModel[model] ) = [Selected Model], "#1B1F24", IF ( SELECTEDVALUE ( MLModel[is_baseline] ) = 1, "#D8D2C4", "#A9A294" ) )
		displayFolder: Formatting
		lineageTag: c337c981-31b5-58dc-bf10-cfe33dded139

	measure 'ROC AUC (selected)' = CALCULATE ( [ROC AUC], TREATAS ( VALUES ( TestPredictions[model] ), MLModel[model] ) )
		formatString: 0.00
		displayFolder: Model
		lineageTag: 52600a31-e29f-5fa2-938d-578bb5b0297f

