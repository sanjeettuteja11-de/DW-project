	partition ModelMetrics = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "ModelMetrics.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"feature_set", type text}, {"model", type text}, {"params", type text}, {"split", type text}, {"n", Int64.Type}, {"accuracy", type number}, {"precision", type number}, {"recall", type number}, {"f1", type number}, {"roc_auc", type number}, {"tn", Int64.Type}, {"fp", Int64.Type}, {"fn", Int64.Type}, {"tp", Int64.Type}, {"model_label", type text}, {"is_baseline", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

