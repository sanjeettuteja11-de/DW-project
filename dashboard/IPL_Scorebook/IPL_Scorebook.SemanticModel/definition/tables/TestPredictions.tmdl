	partition TestPredictions = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "TestPredictions.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"match_key", Int64.Type}, {"source_match_id", Int64.Type}, {"match_date", type date}, {"season", Int64.Type}, {"feature_set", type text}, {"model", type text}, {"score", type number}, {"prob_bat_first_wins", type number}, {"predicted_bat_first_won", Int64.Type}, {"actual_bat_first_won", Int64.Type}, {"correct", Int64.Type}, {"model_label", type text}, {"bat_first_team", type text}, {"chase_team", type text}, {"winner_team", type text}, {"venue_key", Int64.Type}, {"pp_run_rate_diff", type number}, {"pp_diff_band", type text}, {"pp_diff_band_order", type number}, {"confidence", type number}, {"predicted_label", type text}, {"actual_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

