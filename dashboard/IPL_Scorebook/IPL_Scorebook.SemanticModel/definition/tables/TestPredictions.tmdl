table TestPredictions
	lineageTag: 23ccee60-8fcc-5ee3-9b9f-1789eda352e5

	measure Predictions = COUNTROWS ( TestPredictions )
		formatString: #,0
		displayFolder: Model
		lineageTag: 21676b7b-0972-58f0-a415-9bc08871e02c

	measure 'Test Matches' = DISTINCTCOUNT ( TestPredictions[match_key] )
		formatString: #,0
		displayFolder: Model
		lineageTag: 419fe3d1-9052-5d60-b34d-0aa716776caa

	measure 'Hit Rate' = AVERAGE ( TestPredictions[correct] )
		formatString: 0.0%
		displayFolder: Model
		lineageTag: c7e74179-4f9a-5c2f-8a85-2f6dcc4a1916

	measure 'Lift vs Baseline' = ( [Hit Rate] - [Baseline Accuracy] ) * 100
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: Model
		lineageTag: 979bd227-e42c-5a34-b8c6-fe79447db91f

	measure 'P(Bat First Wins)' = AVERAGE ( TestPredictions[prob_bat_first_wins] )
		formatString: 0.00
		displayFolder: Model
		lineageTag: 0585bd89-99bc-5298-b038-617bf3286042

	measure 'PP Gap' = AVERAGE ( TestPredictions[pp_run_rate_diff] )
		formatString: 0.0
		displayFolder: Model
		lineageTag: d8422af6-b687-53e2-b39b-525936761fc6

	measure 'Confident Miss P' = CALCULATE ( AVERAGE ( TestPredictions[prob_bat_first_wins] ), TestPredictions[correct] = 0, TestPredictions[confidence] >= 0.7 )
		formatString: 0.00
		displayFolder: Model
		lineageTag: c5ca1a92-c125-567c-8999-731afeb26cbb

	measure 'Confident Misses' = CALCULATE ( COUNTROWS ( TestPredictions ), TestPredictions[correct] = 0, TestPredictions[confidence] >= 0.7 ) + 0
		formatString: #,0
		displayFolder: Model
		lineageTag: ef89021d-872f-5a5e-836b-d7eb980db2e7

