		formatString: 0
		lineageTag: 2cfe8698-2e53-5a3d-9776-9abedb7f2a73
		summarizeBy: none
		sourceColumn: season

		annotation SummarizationSetBy = Automatic

	column era
		dataType: string
		lineageTag: c5fc17a7-5708-5d7c-affb-f837a161c990
		summarizeBy: none
		sourceColumn: era

		annotation SummarizationSetBy = Automatic

	partition Season = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("H4sIAAAAAAAC/33Quw5CIRCE4Z6noNQEE3bh3Fo7O9/AELM2Xo4Bm/P2MnbT2JEvW8xPs9LW1+VuW2i/Z7BanASNcQ5Hu63VvEZNTkELUeokkSiDhGgAKdEISkQTKBPNoIFoAY1EfUC3iQ37hfcLAoQDBAXKBYIE5QRBg3KDIEJTOD3f5frx50fZrPr+eX4HP+ydoEnzn4sv966wln0BAAA=", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "Season.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"season_key", Int64.Type}, {"season", Int64.Type}, {"era", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

