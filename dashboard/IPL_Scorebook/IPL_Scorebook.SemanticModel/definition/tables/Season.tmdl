table Season
	lineageTag: 95a876c7-ad8f-5aae-91f0-42f1dedd372e

	measure 'Season Range' = VAR a = MIN ( Season[season] ) VAR b = MAX ( Season[season] ) RETURN IF ( a = b, FORMAT ( a, "0" ), FORMAT ( a, "0" ) & "–" & FORMAT ( b, "0" ) )
		displayFolder: Labels
		lineageTag: 586bd2a9-0b11-5e7a-8ec1-9932378817b0

	measure 'First Season' = MIN ( Season[season] )
		formatString: 0
		displayFolder: Labels
		lineageTag: 1af5cfe8-27ae-53bc-a7d1-4c8bfd964f5f

	measure 'Last Season' = MAX ( Season[season] )
		formatString: 0
		displayFolder: Labels
		lineageTag: 353a458f-043f-59d9-a85e-d078b4b7bcea

	column season_key
		dataType: int64
		formatString: 0
		lineageTag: 11e1107b-28e0-5e68-b303-58af4ab808e3
		summarizeBy: none
		isHidden
		sourceColumn: season_key

		annotation SummarizationSetBy = Automatic

	column season
