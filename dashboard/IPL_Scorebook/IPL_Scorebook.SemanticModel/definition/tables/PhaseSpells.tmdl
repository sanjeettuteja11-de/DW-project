	partition PhaseSpells = m
		mode: import
		source =
				let
				    Raw = if DataFolder = null or Text.Length(DataFolder) = 0 then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & "PhaseSpells.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"profile_key", Int64.Type}, {"player_key", Int64.Type}, {"player", type text}, {"role_type", type text}, {"primary_phase", type text}, {"phase_index_value", type number}, {"valid_from_season", Int64.Type}, {"valid_to_season", type number}, {"last_seen_season", Int64.Type}, {"qualifying_seasons", Int64.Type}, {"is_current", Int64.Type}, {"spell_status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

