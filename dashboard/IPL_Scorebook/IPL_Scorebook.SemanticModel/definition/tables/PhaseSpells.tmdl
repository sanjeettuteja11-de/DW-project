table PhaseSpells
	lineageTag: c850b510-4814-5732-a06b-4e2e10a34844

	measure Spells = COUNTROWS ( PhaseSpells )
		formatString: #,0
		displayFolder: Phase drift
		lineageTag: 1c4d4a2b-2544-512f-9797-9d988996e0aa

	measure 'Drift Pool' = COUNTROWS ( FILTER ( SUMMARIZE ( PhaseSpells, PhaseSpells[player_key], PhaseSpells[role_type] ), CALCULATE ( SUM ( PhaseSpells[qualifying_seasons] ) ) >= 2 ) )
		formatString: #,0
		displayFolder: Phase drift
		lineageTag: fcab1e2b-8778-5755-b46e-c2dbad1bf1ad

	measure 'Players Who Changed' = COUNTROWS ( FILTER ( SUMMARIZE ( PhaseSpells, PhaseSpells[player_key], PhaseSpells[role_type] ), CALCULATE ( COUNTROWS ( PhaseSpells ) ) > 1 ) )
		formatString: #,0
		displayFolder: Phase drift
		lineageTag: 8d341f2a-af6f-56e3-84db-7c620b190ee1

	measure 'Changed %' = DIVIDE ( [Players Who Changed], [Drift Pool] )
		formatString: 0%
		displayFolder: Phase drift
		lineageTag: 4a25296b-6d98-5044-9ac9-c898a7f16ddf

	measure 'Qualifying Seasons' = SUM ( PhaseSpells[qualifying_seasons] )
		formatString: 0
		displayFolder: Phase drift
		lineageTag: bfa00e4a-41a7-553f-a55f-2c55c0dbbc79

	measure 'Spell Colour' = SWITCH ( SELECTEDVALUE ( PhaseSpells[primary_phase] ), "Powerplay", "#C8553D", "Middle", "#2E6F95", "Death", "#2F5D50", "#8C9196" )
		displayFolder: Formatting
		lineageTag: 4a4b1988-0886-5276-925c-4f3427036c14

	column profile_key
		dataType: int64
		formatString: 0
		lineageTag: 30f20d04-c732-58b7-a5c9-9f0c85a453a1
		summarizeBy: none
		isHidden
		sourceColumn: profile_key

		annotation SummarizationSetBy = Automatic

	column player_key
